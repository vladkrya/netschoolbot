[Unit]
Description=Резервная копия базы бота «Сетевого города»
OnFailure=netschoolbot-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/netschoolbot
EnvironmentFile=-/opt/netschoolbot/.env
ExecStart=/opt/netschoolbot/venv/bin/python -m app.tools.backup --keep 20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/netschoolbot/data
