[Unit]
Description=Непрерывная копия базы бота в Object Storage (Litestream)
After=network-online.target
Wants=network-online.target
OnFailure=netschoolbot-alert@%n.service
# Пять падений за 10 минут — служба считается упавшей, и админ узнает.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
WorkingDirectory=/opt/netschoolbot
EnvironmentFile=/opt/netschoolbot/.env
ExecStart=/usr/bin/litestream replicate -config /opt/netschoolbot/deploy/litestream/litestream.yml
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/netschoolbot/data

[Install]
WantedBy=multi-user.target
