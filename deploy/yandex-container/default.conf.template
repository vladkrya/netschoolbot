# Всё — на ns.ikrya.ru (yavds) как есть. Между облаком и ВМ белых списков нет.
server {
    listen ${PORT};
    # Фото и видео к отчёту об ошибке — до 15 МБ, как на ns.ikrya.ru.
    client_max_body_size 16m;

    location / {
        proxy_pass https://ns.ikrya.ru;
        proxy_set_header Host ns.ikrya.ru;
        proxy_ssl_server_name on;
        proxy_ssl_name ns.ikrya.ru;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        # Обновление дневника жестом ждёт школьный сервер до минуты.
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
    }
}
