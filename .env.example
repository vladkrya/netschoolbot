# ============ Telegram ============
NETSCHOOL_BOT_TOKEN=123456:AA...          # основной бот NetSchool
NETSCHOOL_REDIRECT_BOT_TOKEN=             # @Netschool13_bot: ссылка на @netschoolbot
LOG_BOT_TOKEN=                            # необязательно: бот для логов
TG_ADMIN_ID=123456789                     # админ: логи и отчёты об ошибках
TELEGRAM_LOGGING_ENABLED=true
# TELEGRAM_API_PROXY=socks5://127.0.0.1:1080

# ============ Проверка оценок ============
# Ни школы, ни адреса «Сетевого города» по умолчанию здесь нет: каждый
# выбирает свой регион и школу сам при /login.
CHECK_INTERVAL=300                        # интервал проверки по умолчанию, сек

# ============ Веб / PWA ============
NETSCHOOL_WEB_ENABLED=true
NETSCHOOL_WEB_HOST=127.0.0.1
NETSCHOOL_WEB_PORT=8283
NETSCHOOL_PUBLIC_URL=https://ns.ikrya.ru
# Резервный адрес того же приложения (кнопка в /app_install и /app_reset).
NETSCHOOL_MIRROR_URL=
# Домен, через который установленное на iPhone приложение открывает вложения:
# обязательно не тот, где установлено приложение, иначе iOS не покажет
# просмотр. Пусто — NETSCHOOL_PUBLIC_URL или NETSCHOOL_MIRROR_URL.
NETSCHOOL_FILES_URL=
# Капча перед отчётом об ошибке из мини-приложения; пусто — кнопки нет.
NETSCHOOL_CAPTCHA_URL=https://captcha.ikrya.ru
NETSCHOOL_CAPTCHA_ROUNDS=2
# Пусто — приложение с корня домена.
NETSCHOOL_MINIAPP_PATH=
NETSCHOOL_MINIAPP_TOKEN_TTL=900
NETSCHOOL_CACHE_FRESH_SECONDS=3600

# Web push (сгенерировать: python -m app.tools.vapid)
NETSCHOOL_VAPID_PUBLIC_KEY=
NETSCHOOL_VAPID_PRIVATE_KEY=
NETSCHOOL_VAPID_SUBJECT=mailto:admin@ns.ikrya.ru

# ============ «Сетевой город» ============
# Прокси для всех запросов к школьным серверам (socks5:// или http://).
# NETSCHOOL_PROXY=socks5://логин:пароль@хост:порт
# Исключения по хостам: host=прокси через запятую, `host=` — напрямую.
# NETSCHOOL_PROXY_HOSTS=sgo.example.ru=
# Запасной прокси, если основной не соединился с сервером школы; затем — напрямую.
# NETSCHOOL_BACKUP_PROXY=socks5://логин:пароль@хост:порт
# NETSCHOOL_FALLBACK_PROXY=socks5://127.0.0.1:1082
NETSCHOOL_HTTP_TIMEOUT=20
# Вложения заданий скачиваются заранее и хранятся столько дней (0 — не скачивать),
# чтобы открывались, когда «Сетевой город» лежит. Предел места — в МБ.
NETSCHOOL_KEEP_ATTACHMENTS_DAYS=14
NETSCHOOL_KEEP_ATTACHMENTS_MB=3000
# Секрет приложения NetSchool для мобильного API (/changeapi). Пусто — режим выключен.
NETSCHOOL_MOBILE_CLIENT_SECRET=

# ============ Прочее ============
NETSCHOOL_DATA_DIR=                       # по умолчанию ./data
# Ключ шифрования паролей и сессий в базе (Fernet). Сгенерировать:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Смена ключа: NETSCHOOL_SECRET_KEY=новый,старый — после рестарта старый можно убрать.
# Потеря ключа = пользователям придётся заново войти через /login.
NETSCHOOL_SECRET_KEY=
DEBUG_MODE=false

# ============ CalDAV ============
# Работает внутри веб-сервера на /caldav/, отдельный порт не нужен.
NETSCHOOL_CALDAV_ENABLED=true
# Интервал проверки школы, секунды (минимум 300).
NETSCHOOL_CALDAV_INTERVAL=1800

# ============ ИИ-помощник ============
# Ключ OpenRouter (https://openrouter.ai/keys); пусто — помощник выключен.
NETSCHOOL_ASSISTANT_API_KEY=
NETSCHOOL_ASSISTANT_MODEL=openrouter/free
# Прокси до OpenRouter, если сервер не достаёт его напрямую.
# Из России OpenRouter отвечает 403 — нужен прокси с выходом за границей.
# NETSCHOOL_ASSISTANT_PROXY=socks5://127.0.0.1:1080
NETSCHOOL_ASSISTANT_DAILY_LIMIT=30

# Почта для входа на сайт без Telegram: коды подтверждения и сброса пароля.
# Без хоста вход по почте работает, но писем нет (сброс — через бота).
# MAIL_SMTP_SECURITY: starttls (порт 587), ssl (465) или plain (локальный сервер).
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_SECURITY=starttls
MAIL_FROM=
# Имя в сертификате, если host — не оно (SSH-туннель на 127.0.0.1): MAIL_SMTP_TLS_NAME=mail.example.com
MAIL_SMTP_TLS_NAME=
